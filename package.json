{
  "name": "graybeard",
  "version": "1.1.0",
  "description": "The Evidence-Enforced Principal Engineering Control Loop for AI Coding Agents.",
  "type": "module",
  "main": "core/index.js",
  "bin": {
    "graybeard": "scripts/graybeard.js"
  },
  "exports": {
    ".": "./core/index.js",
    "./router": "./core/router.js",
    "./classifier": "./core/classifier.js",
    "./risk": "./core/risk.js",
    "./repository": "./core/repository.js",
    "./evidence": "./core/evidence.js",
    "./guard": "./core/guard.js",
    "./gates": "./core/gates.js",
    "./installer": "./core/installer.js",
    "./oracles": "./core/oracles.js",
    "./memory": "./memory/store.js"
  },
  "files": [
    "core",
    "adapters",
    "skills",
    "memory",
    "schemas",
    "scripts",
    "benchmarks",
    "assets",
    "README.md",
    "LICENSE"
